{
  "comments": {
    "lineComment": "#",
    "blockComment": ["{#", "#}"]
  },
  "brackets": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"],
    ["{%", "%}"],
    ["{{", "}}"]
  ],
  "autoClosingPairs": [
    { "open": "{", "close": "}" },
    { "open": "[", "close": "]" },
    { "open": "(", "close": ")" },
    { "open": "{%", "close": "%}" },
    { "open": "{{", "close": "}}" },
    { "open": "{#", "close": "#}" },
    { "open": "\"", "close": "\"", "notIn": ["string"] },
    { "open": "'", "close": "'", "notIn": ["string"] }
  ],
  "surroundingPairs": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"],
    ["\"", "\""],
    ["'", "'"]
  ],
  "indentationRules": {
    "increaseIndentPattern": "{%\\s*(for|if|block|macro|with|set\\s+.*=)?\\s*.*%}",
    "decreaseIndentPattern": "{%\\s*(endfor|endif|endblock|endmacro|endwith)\\s*%}"
  }
}
